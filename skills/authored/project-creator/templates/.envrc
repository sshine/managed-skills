# Re-evaluate when a local module or the flake changes.
#
# The guard keeps the first run quiet: this file is written before nix/ exists, and an
# unmatched glob would otherwise be passed to watch_file literally.
for f in flake.nix nix/*.nix; do
  if [ -e "$f" ]; then
    watch_file "$f"
  fi
done

use flake
